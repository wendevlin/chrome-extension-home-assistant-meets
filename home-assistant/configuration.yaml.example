# Beispiel Konfiguration für Google Meets Integration

google_meets:
  # Optional: Bridge Server URL
  # Standard: http://localhost:8555
  bridge_url: http://localhost:8555

# Beispiel Automationen

automation:
  # Mikrofon stumm schalten wenn jemand an der Tür klingelt
  - alias: "Google Meets - Mute on Doorbell"
    trigger:
      - platform: state
        entity_id: binary_sensor.doorbell
        to: "on"
    condition:
      - condition: state
        entity_id: binary_sensor.google_meets_call_active
        state: "on"
    action:
      - service: switch.turn_off
        target:
          entity_id: switch.google_meets_microphone

  # Benachrichtigung wenn ein Call startet
  - alias: "Google Meets - Notify on Call Start"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "on"
    action:
      - service: notify.mobile_app
        data:
          message: "Google Meets Call gestartet"
          title: "Video Call"

  # Benachrichtigung wenn ein Call endet
  - alias: "Google Meets - Notify on Call End"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "off"
    action:
      - service: notify.mobile_app
        data:
          message: "Google Meets Call beendet"

  # Mikrofon automatisch aktivieren bei Call Start
  - alias: "Google Meets - Unmute on Call Start"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "on"
    action:
      - delay:
          seconds: 2
      - service: switch.turn_on
        target:
          entity_id: switch.google_meets_microphone

  # Lichter dimmen während eines Calls
  - alias: "Google Meets - Dim Lights During Call"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "on"
    action:
      - service: light.turn_on
        target:
          entity_id: light.office
        data:
          brightness_pct: 50

  # Lichter zurück auf normal nach Call
  - alias: "Google Meets - Restore Lights After Call"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "off"
    action:
      - service: light.turn_on
        target:
          entity_id: light.office
        data:
          brightness_pct: 100
