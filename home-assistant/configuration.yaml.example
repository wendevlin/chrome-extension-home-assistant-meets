# Example Configuration for Google Meets Integration

# Minimal configuration - no additional settings required!
google_meets:

# Example Automations

automation:
  # Mute microphone when doorbell rings
  - alias: "Google Meets - Mute on Doorbell"
    trigger:
      - platform: state
        entity_id: binary_sensor.doorbell
        to: "on"
    condition:
      - condition: state
        entity_id: binary_sensor.google_meets_call_active
        state: "on"
    action:
      - service: switch.turn_off
        target:
          entity_id: switch.google_meets_microphone

  # Notification when call starts
  - alias: "Google Meets - Notify on Call Start"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "on"
    action:
      - service: notify.mobile_app
        data:
          message: "Google Meets Call started"
          title: "Video Call"

  # Notification when call ends
  - alias: "Google Meets - Notify on Call End"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "off"
    action:
      - service: notify.mobile_app
        data:
          message: "Google Meets Call ended"

  # Automatically unmute microphone on call start
  - alias: "Google Meets - Unmute on Call Start"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "on"
    action:
      - delay:
          seconds: 2
      - service: switch.turn_on
        target:
          entity_id: switch.google_meets_microphone

  # Dim lights during a call
  - alias: "Google Meets - Dim Lights During Call"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "on"
    action:
      - service: light.turn_on
        target:
          entity_id: light.office
        data:
          brightness_pct: 50

  # Restore lights to normal after call
  - alias: "Google Meets - Restore Lights After Call"
    trigger:
      - platform: state
        entity_id: binary_sensor.google_meets_call_active
        to: "off"
    action:
      - service: light.turn_on
        target:
          entity_id: light.office
        data:
          brightness_pct: 100
